# syntax=docker/dockerfile:1

FROM eclipse-temurin:25-jdk AS gradle-cache

WORKDIR /workspace
COPY . /workspace/

RUN --mount=type=cache,target=/root/.gradle,sharing=locked,id=simplematch-flyway-runtime-gradle \
    chmod 0555 /workspace/gradlew \
    && /workspace/gradlew --no-daemon prepareFlywayRuntimeAll \
    && mkdir -p /opt/simplematch/gradle-cache/wrapper/dists /opt/simplematch/gradle-cache/caches \
    && cp -a /root/.gradle/wrapper/dists/. /opt/simplematch/gradle-cache/wrapper/dists/ \
    && cp -a /root/.gradle/caches/. /opt/simplematch/gradle-cache/caches/ \
    && find /opt/simplematch/gradle-cache -type f -name '*.lock' -delete \
    && touch /opt/simplematch/gradle-cache/flyway-runtime.ready

FROM eclipse-temurin:25-jdk

RUN apt-get update \
    && apt-get install --no-install-recommends --yes bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY --from=gradle-cache --chown=10001:10001 /opt/simplematch/gradle-cache/ /opt/simplematch/gradle-cache/
COPY --chown=10001:10001 . /workspace/
COPY --from=gradle-cache --chown=10001:10001 /workspace/build-logic/build/ /workspace/build-logic/build/
COPY --chown=10001:10001 deploy/docker/run-flyway /app/run-flyway

RUN chmod 0555 /app/run-flyway /workspace/gradlew \
    && useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin simplematch \
    && mkdir -p /tmp/gradle \
    && chown 10001:10001 /workspace /app /opt/simplematch /tmp/gradle

ENV HOME=/tmp
ENV GRADLE_USER_HOME=/tmp/gradle
ENV SIMPLEMATCH_GRADLE_CACHE_SEED_DIR=/opt/simplematch/gradle-cache
ENV SIMPLEMATCH_GRADLE_PROJECT_CACHE_DIR=/tmp/gradle-project

USER 10001:10001
ENTRYPOINT ["/app/run-flyway"]
