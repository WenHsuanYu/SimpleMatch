{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;json-config"
      }
    },
    {
      "name": "ci-fast",
      "displayName": "CI Fast Native Validation",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;json-config",
        "VCPKG_TARGET_TRIPLET": "x64-linux-ci",
        "VCPKG_HOST_TRIPLET": "x64-linux-ci",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "ci-sanitize",
      "displayName": "CI ASan + UBSan",
      "inherits": "ci-fast",
      "cacheVariables": {
        "SIMPLEMATCH_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang-tidy-report",
      "displayName": "Google-style clang-tidy baseline (report-only)",
      "inherits": "ci-fast",
      "cacheVariables": {
        "SIMPLEMATCH_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "full-native-dev",
      "displayName": "Full Native Development Environment",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;messaging;json-config",
        "SIMPLEMATCH_ENABLE_MESSAGING": "ON"
      }
    },
    {
      "name": "full-clang-tidy-report",
      "displayName": "Full Native Kafka / Google-style clang-tidy baseline",
      "inherits": "full-native-dev",
      "cacheVariables": {
        "SIMPLEMATCH_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "ci-fast",
      "configurePreset": "ci-fast"
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize"
    },
    {
      "name": "clang-tidy-report",
      "configurePreset": "clang-tidy-report",
      "targets": [
        "simplematch_clang_tidy_report"
      ]
    },
    {
      "name": "full-native-dev",
      "configurePreset": "full-native-dev"
    },
    {
      "name": "full-clang-tidy-report",
      "configurePreset": "full-clang-tidy-report",
      "targets": [
        "simplematch_clang_tidy_report"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-fast",
      "configurePreset": "ci-fast",
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize",
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      }
    },
    {
      "name": "full-native-dev",
      "configurePreset": "full-native-dev",
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      }
    }
  ]
}
