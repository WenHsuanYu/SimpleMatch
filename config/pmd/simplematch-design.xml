<?xml version="1.0" encoding="UTF-8"?>
<ruleset
    name="SimpleMatch production design policy"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
  <description>
    The deliberately small, explicitly enumerated PMD design policy for handwritten
    production Java. Generated and test sources are outside this policy.
  </description>

  <rule ref="category/java/design.xml/ExcessiveParameterList"/>
  <rule ref="category/java/design.xml/CyclomaticComplexity"/>
  <rule ref="category/java/design.xml/NcssCount"/>
  <rule ref="category/java/design.xml/ExcessivePublicCount"/>
  <rule ref="category/java/design.xml/TooManyMethods"/>
</ruleset>
