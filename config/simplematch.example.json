{
  "env": "dev",
  "kafka": {
    "brokers": "localhost:9092",
    "topics": {
      "ordersCommands": "orders.commands",
      "ordersValidated": "orders.validated",
      "matchingExecutions": "matching.executions",
      "marketdataEvents": "marketdata.events",
      "auditEvents": "audit.events"
    },
    "partitions": {
      "ordersCommands": 15,
      "ordersValidated": 15,
      "matchingExecutions": 15
    }
  },
  "postgres": {
    "dsn": "postgresql://simplematch:simplematch@localhost:5432/simplematch"
  },
  "redis": {
    "endpoints": ["localhost:6379"]
  },
  "grpc": {
    "targets": {
      "accountService": "dns:///account-service:50051",
      "riskService": "dns:///risk-service:50052"
    }
  },
  "routing": {
    "snapshotPath": "config/routing/orders-validated.snapshot.json"
  },
  "observability": {
    "otel": {
      "exporterOtlpEndpoint": "http://localhost:4318"
    },
    "prometheus": {
      "port": 9464
    }
  },
  "quickfixGateway": {
    "quickfixConfigPath": "config/quickfix/acceptor.cfg",
    "walPath": "data/quickfix/wal/inbound.wal",
    "ownerId": "quickfix-gateway-0",
    "riskClient": {
      "deadlineMillis": 1500,
      "retry": {
        "maxAttempts": 2,
        "backoffMillis": 50
      },
      "breaker": {
        "consecutiveFailures": 3,
        "openDurationMillis": 1000
      }
    }
  }
}
